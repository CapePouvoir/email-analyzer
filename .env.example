# =============================================================================
# Email Forensic Analyzer - Configuration
# =============================================================================
# Copie ce fichier en .env et adapte les valeurs
# Exemple : cp .env.example .env
# =============================================================================

# --- Ollama (LLM Local) ---
# URL de l'API Ollama (par défaut : http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Modèle à utiliser (ex: mistral, deepseek, llama3)
# Pour voir les modèles disponibles : ollama list
OLLAMA_MODEL=mistral

# Timeout pour les requêtes Ollama (en secondes)
OLLAMA_TIMEOUT=120

# --- Stockage ---
# Dossier où stocker les fichiers .eml uploadés
UPLOAD_DIR=./data/uploads

# Nombre de jours avant suppression automatique des fichiers
CLEANUP_DAYS=7

# --- Serveur Web ---
# Hôte de l'API (0.0.0.0 pour accéder depuis le réseau)
HOST=0.0.0.0

# Port de l'API
PORT=8000

# --- Authentification Admin ---
# Mot de passe pour accéder à l'interface admin (route /admin)
# LAISSE VIDE pour désactiver l'auth admin
ADMIN_PASSWORD=changeme

# --- Options d'analyse ---
# Taille maximale des fichiers uploadés (en Mo)
MAX_FILE_SIZE_MB=50

# Liste des extensions de fichiers bloquées (séparées par des virgules)
BLOCKED_EXTENSIONS=.exe,.bat,.sh,.js,.vbs,.ps1,.jar,.msi

# --- VirusTotal (Optionnel) ---
# Si tu veux activer les requêtes automatiques à VirusTotal,
# décommente et ajoute ta clé API ci-dessous.
# Sinon, les hash seront juste affichés pour vérification manuelle.
# VIRUSTOTAL_API_KEY=ton_api_key_ici
